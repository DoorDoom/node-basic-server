{
  "name": "node-basic-server",
  "version": "1.0.0",
  "description": "",
  "keywords": [
    "nodejs",
    "server"
  ],
  "homepage": "https://github.com/DoorDoom/node-basic-server#readme",
  "bugs": {
    "url": "https://github.com/DoorDoom/node-basic-server/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DoorDoom/node-basic-server.git"
  },
  "engines": {
    "node": ">=24.10.0",
    "npm": ">=10.9.0"
  },
  "author": "DoorDoom",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "start:dev": "nodemon \"src/index.ts\"",
    "start:multi": "ts-node \"src/multi-index.ts\"",
    "start:prod": "tsc && node \"dist/index.js\"",
    "test": "node --test --require ts-node/register \"src/index.test.ts\"",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/node": "^20.19.37",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2"
  }
}
